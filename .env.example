# The app needs two values to find your Supabase database.
# Both are PUBLIC by design: they are sent to every browser that opens the app.
# What protects your data is the login plus the database's own access rules.
#
# The real values live in the file named ".env" (same two lines, filled in).
#
# NEVER put a Supabase "secret" key, "service_role" key or database password
# in this file or anywhere else in this project.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
